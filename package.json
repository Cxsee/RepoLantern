{
  "name": "repolantern",
  "productName": "RepoLantern",
  "version": "0.11.0",
  "private": true,
  "description": "Understand any codebase. Change it with confidence.",
  "author": "Andrea Caselli",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "electron-vite build && node --test --test-concurrency=1 --test-timeout=180000 --test-force-exit e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "io.github.cxsee.repolantern",
    "productName": "RepoLantern",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "extraResources": [
      "THIRD-PARTY-NOTICES.txt",
      "LICENSE"
    ],
    "files": [
      "out/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
